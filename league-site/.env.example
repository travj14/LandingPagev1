# Copy to .env and fill in. start.sh, restart.sh and refresh.sh read it.

# Port the site listens on (nginx proxies payrollgm.com to it).
PORT=3457

# Set to production on the server. The refresh endpoint then requires REFRESH_TOKEN.
NODE_ENV=development

# Password for forcing a refresh over HTTP. Make it long and random, e.g. the output of: openssl rand -hex 24
REFRESH_TOKEN=

# Nightly refresh runs at midnight in this time zone.
REFRESH_TZ=America/New_York

# Which Sleeper league to show.
LEAGUE_ID=1311995439410581504

# Public address, used to make link-preview URLs absolute (e.g. https://payrollgm.com).
# Leave unset to use whatever host the request came in on.
# SITE_URL=https://payrollgm.com
